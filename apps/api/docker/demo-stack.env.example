# Template for ~/apps/compendium/.env.demo on the server (public demo stack).
# Copy it, fill it in, chmod 600. Never reuse an owner-stack value for any of
# the random secrets; generate each with: openssl rand -hex 32
DEMO_POSTGRES_PASSWORD=
DEMO_JWT_SECRET_KEY=
DEMO_SESSION_INGRESS_TRUSTED_VALUE=
# The published demo-account password (the README's hosted-demo section).
DEMO_ACCOUNT_PASSWORD=
# The Vercel production origin, e.g. https://compendium.example.com
DEMO_CORS_ORIGINS=
# The provider-capped demo OpenAI key (moved off the owner stack at cutover).
DEMO_OPENAI_API_KEY=
# Public-edge settings, moved here from the owner API at cutover.
DEMO_RATE_LIMIT_TRUST_CF_HEADER=1
# Must equal Vercel's BACKEND_PROXY_SECRET when that is set; else leave empty.
DEMO_PROXY_SHARED_SECRET=
DEMO_API_HOST_PORT=8002
# One-click entry (demo-one-click-entry, 2026-10-09). Leave DEMO_PUBLIC_ENTRY
# at 0 until the Turnstile widget exists; the secret comes from the
# Cloudflare dashboard (Turnstile -> the site's widget -> Secret key).
DEMO_PUBLIC_ENTRY=0
DEMO_TURNSTILE_SECRET_KEY=
