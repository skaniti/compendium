# /etc/caddy-owner/env -- read by caddy-owner.service (EnvironmentFile).
# Real values live only on the server; see the private operator runbook.
OWNER_HOSTNAME=my.example.test
TAILNET_HOSTNAME=<server>.<tailnet>.ts.net
TAILNET_IPV4=100.64.0.1
TAILNET_IPV6=fd7a:115c:a1e0::1
ACMEDNS_CREDENTIALS=/etc/caddy-owner/acmedns.json
