# Owner gateway (owner-gateway, 2026-10-10): the tailnet-only owner Compendium
# at {$OWNER_HOSTNAME}, with {$TAILNET_HOSTNAME} (the server's ts.net name)
# as a fallback. Values come from /etc/caddy-owner/env (template:
# env.example); the operator runbook is private (docs/runbooks/).
# Listens ONLY on the server's two tailnet addresses; no port 80. Defence in
# depth: a caller whose TCP peer is outside the tailnet ranges is aborted
# before the snippet runs (remote_ip is the peer, not X-Forwarded-For).
# Certificates: the owner name by DNS-01 through acme-dns CNAME delegation
# (no Cloudflare token on the server); the ts.net name from tailscaled
# (needs TS_PERMIT_CERT_UID=caddy in tailscaled's environment).
{
	auto_https disable_redirects
	admin unix//run/caddy-owner/admin.sock
}

{$OWNER_HOSTNAME} {
	bind {$TAILNET_IPV4} {$TAILNET_IPV6}
	tls {
		dns acmedns {$ACMEDNS_CREDENTIALS}
		resolvers 1.1.1.1 8.8.8.8
	}
	@outside_tailnet not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	route {
		abort @outside_tailnet
		import owner-app.caddy 127.0.0.1:3000 127.0.0.1:9180
	}
}

{$TAILNET_HOSTNAME} {
	bind {$TAILNET_IPV4} {$TAILNET_IPV6}
	tls {
		get_certificate tailscale
	}
	@outside_tailnet not remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	route {
		abort @outside_tailnet
		import owner-app.caddy 127.0.0.1:3000 127.0.0.1:9180
	}
}
