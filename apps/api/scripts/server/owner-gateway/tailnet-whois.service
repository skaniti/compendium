# Tailscale identity helper for the owner gateway (owner-gateway, 2026-10-10).
# Installed by install-owner-gateway.sh to /etc/systemd/system/.
[Unit]
Description=Tailscale identity helper for the owner Compendium gateway
After=tailscaled.service network-online.target
Wants=network-online.target

[Service]
ExecStart=python3 /opt/owner-gateway/whois_auth.py --host 127.0.0.1 --port 9180
DynamicUser=yes
Restart=always
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/run/tailscale
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
