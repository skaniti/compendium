# apps/api environment configuration.
#
# Copy to .env and fill in real values for local dev. Settings.model_config
# also reads ~/.secrets (see backend/config/settings.py) -- that's an
# alternate location for secrets on a shared/server box, not a second file
# you need here.
#
# No real values below -- every line is a placeholder or the same default
# already baked into Settings. Only variables the code actually reads are
# listed (grepped from backend/config/settings.py and os.environ/os.getenv
# call sites across backend/ and scripts/).

# ==============================================================================
# Environment
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8001

# ==============================================================================
# Database
# ==============================================================================
DATABASE_URL=postgresql://tbd:tbd_local@localhost:5433/traversal_discovery
TEST_DATABASE_URL=postgresql://tbd:tbd_local@localhost:5433/traversal_discovery_test

# ==============================================================================
# URLs & CORS
# ==============================================================================
FRONTEND_URL=http://localhost:8050
# "*" is dev-only -- Settings hard-fails at startup if ENVIRONMENT != development
# and CORS_ORIGINS is still "*". In production set a comma-separated explicit list.
CORS_ORIGINS=*

# ==============================================================================
# LLM API Keys
# ==============================================================================
OPENAI_API_KEY=<your-openai-api-key>
# Optional: separate key for demo-role agent queries so demo spend is capped
# at the provider without bounding the owner's own usage. Falls back to
# OPENAI_API_KEY when unset.
OPENAI_API_KEY_DEMO=<your-openai-demo-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>
HF_TOKEN=<your-huggingface-token>

# ==============================================================================
# Content Fetching APIs
# ==============================================================================
YOUTUBE_API_KEY=<your-youtube-data-api-key>

# ==============================================================================
# LangSmith Monitoring
# ==============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=<your-langsmith-api-key>
LANGCHAIN_PROJECT=compendium

# ==============================================================================
# JWT Authentication
# ==============================================================================
# No safe default in production -- Settings hard-fails at startup if this is
# still "change-me-in-production" and ENVIRONMENT != development.
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Session expiry tuning (the 2026-09-09 session-expiry-tuning plan (private),
# spec D1, amended 2026-09-10). A "remembered"
# session gets this longer refresh lifetime instead of the default above.
JWT_REFRESH_TOKEN_EXPIRE_DAYS_REMEMBERED=90
SESSION_IDLE_MINUTES=60
SESSION_IDLE_MINUTES_DEMO=720
SESSION_IDLE_MINUTES_REMEMBERED=0
# Caddy overwrites this header on both loopback listeners before proxying
# to the app -- SESSION_INGRESS_TRUSTED_VALUE on the tailscale-serve
# listener, "public" on the Cloudflare Tunnel listener -- so it cannot be
# forged by a public caller. The API grants a remembered/90-day session
# only when this header is present and exactly equal to the trusted value.
SESSION_INGRESS_HEADER=X-Compendium-Ingress
SESSION_INGRESS_TRUSTED_VALUE=tailnet
# DEV-ONLY: local development has no Caddy in front of the API, so the
# ingress header above is always absent. Set to true to treat an absent
# header as tailnet-trusted (a solo local session behaves as remembered).
# The API REFUSES to start with this set unless ENVIRONMENT=development --
# it would trust every public caller as tailnet-remembered.
SESSION_TRUST_MISSING_INGRESS=false

# ==============================================================================
# User Identity (dev / bootstrap)
# ==============================================================================
BOOTSTRAP_EMAIL=<your-primary-email>
DEV_DEFAULT_USER_EMAIL=<your-primary-email>

# ==============================================================================
# Model Configuration
# ==============================================================================
DEFAULT_SUMMARY_MODEL=gpt-3.5-turbo
DEFAULT_INFERENCE_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ==============================================================================
# Clustering Configuration
# ==============================================================================
CLUSTERING_EMBEDDING_MODEL=all-MiniLM-L6-v2
CLUSTERING_UMAP_DIMS=0
CLUSTERING_UMAP_N_NEIGHBORS=15
CLUSTERING_TEXT_CONTRACT=ctv2
HDBSCAN_MIN_SAMPLES=2
HDBSCAN_SELECTION_METHOD=eom
HDBSCAN_SELECTION_EPSILON=0.0
HDBSCAN_MIN_CLUSTER_SIZE=2
CLUSTER_IDENTITY_ENABLED=false
AGENT_SYSTEM_PROMPT_VERSION=v2
CLUSTER_NAMING_PROMPT_VERSION=v1a
CLUSTER_IDENTITY_JACCARD=0.5
SUPERCLUSTER_MODE=keywords
SUPERCLUSTER_GROUP_THRESHOLD=0.65
SUPERCLUSTER_SPLIT_THRESHOLD=0.55
SUPERCLUSTER_TOPIC_MATCH_THRESHOLD=0.30
SUPERCLUSTER_CARVE_MARGIN=0.05
SUPERCLUSTER_KEYWORD_EXPANSION=true
SUPERCLUSTER_GROUP_SUPPORT_MIN=0.75
SUPERCLUSTER_SINGLETON_MERGE_THRESHOLD=0.57
SUPERCLUSTER_LABEL_PROMPT_VERSION=v1a
FEATURED_SINGLETONS_VISIBLE_PCT=0.40

# ==============================================================================
# Search Agent Configuration
# ==============================================================================
AGENT_RELEVANCE_THRESHOLD=0.2
AGENT_LOW_CONFIDENCE_SIM_FLOOR=0.40

# ==============================================================================
# Runtime feature flags (read directly via os.environ, not through Settings)
# ==============================================================================
# Kill switches -- unset/"0" means the feature is ON; set "1" to disable.
RERANKER_DISABLED=0
DQ_SCHEDULER_DISABLED=0
DQ_ADJUDICATION_DISABLED=0
DQ_GATE_DISABLED=0
DQ_BOT_DISABLED=0
DQ_OVERRIDES_DISABLED=0
DISABLE_REGISTRATION=0

# dq_bot scheduler run mode: "tier2" (default) or "legacy"
DQ_RUN_MODE=tier2
DQ_WORKER_POLL_SEC=8
DQ_WORKER_REAP_EVERY_TICKS=30
DQ_CLAUDE_MODEL=opus[1m]
DQ_MAX_CANDIDATES_PER_INVESTIGATOR=50
DQ_GATE_DELTA_FACTOR=2.0
DQ_GATE_NOVEL_MIN=10
DQ_GATE_CONFIRM_MIN=5
DQ_GATE_COOLDOWN_DAYS=2

# Nightly maintenance loop: off unless explicitly enabled.
ENABLE_NIGHTLY_MAINT=0
# Optional dev override for the nightly-loop wake interval (seconds, floor 5).
SCHEDULER_OVERRIDE_SECONDS=
# Optional: enables a periodic sweep for stranded pending captures
# (seconds, floor 60). Unset = sweep is off.
PENDING_SWEEP_INTERVAL_SECONDS=

# ==============================================================================
# One-off ops scripts (not read by the running app; only when you invoke the
# corresponding script directly -- see each script's own docstring/usage)
# ==============================================================================
# scripts/backfill_extension_zip.py
COMPENDIUM_BACKFILL_BACKEND_URL=http://localhost:8000
# backend/scripts/bootstrap_user.py
BOOTSTRAP_PASSWORD=<strong-password>
BOOTSTRAP_NAME=user
BOOTSTRAP_LEGACY_EMAIL=dev@localhost
BOOTSTRAP_DEMO_EMAIL=demo@example.com
BOOTSTRAP_DEMO_PASSWORD=<strong-password>
BOOTSTRAP_DEMO_NAME=demo
# backend/scripts/rotate_api_key.py
ROTATE_EMAIL=<email-to-rotate-the-api-key-for>
