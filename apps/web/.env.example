# Backend base URL the Next /api/* proxy forwards to.
# Local dev: the FastAPI dev server. Prod (flip time): the public backend host.
BACKEND_URL=http://localhost:8001

# Task 7e (post-flip-closeout): shared secret proving a backend request
# genuinely came from this proxy, so the backend can trust the attested
# X-Compendium-Client-Ip header for rate-limit keying instead of one shared
# Vercel-egress bucket. Leave unset locally -- inert (lib/proxy-attest.ts
# sends nothing) until set here AND to the same value as the backend's
# PROXY_SHARED_SECRET. The attested address is the first x-forwarded-for
# hop, which is correct on Vercel (it overwrites that header with the real
# client). Self-hosting the standalone image behind your own proxy? Only set
# this if that proxy also overwrites x-forwarded-for; otherwise a client can
# choose its own rate-limit bucket.
# BACKEND_PROXY_SECRET=<shared-secret-with-the-backend>

# Absolute path to the backend repo, used ONLY by scripts/dev.sh to auto-start
# the FastAPI backend for local visual testing. Leave unset and dev.sh skips the
# backend (start it yourself, or run FRONTEND_ONLY=1).
# BACKEND_DIR=/path/to/compendium-explorer

# Prod-mode auth gate (proxy.ts). "1" redirects any page route without an
# access_token cookie to /login. UX only -- the backend's verify_api_key is
# the real enforcement point, this just avoids landing on a shell that will
# 401 everywhere. Leave unset/anything else to keep local dev's no-auth loop.
# AUTH_REQUIRED=1

# Idle threshold (minutes) for SessionKeeper's activity-scoped sliding
# refresh (components/SessionKeeper.tsx, D2). Only real user input
# (pointer/keyboard/wheel/scroll) counts as activity -- background tabs are
# deliberately allowed to idle out, unlike Dash. Leave unset for the
# default (60).
# NEXT_PUBLIC_IDLE_MINUTES=60

# optional: origins (hostname or IP, no scheme; comma-separated) allowed to reach the
# dev server cross-machine, e.g. a LAN IP plus a tailnet IP or MagicDNS name
DEV_LAN_ORIGIN=

# demo/server.mjs (the `npm run demo` stub backend): which fixture set to
# serve. Leave unset for the committed demo/fixtures/ set.
# FIXTURES=demo/fixtures

# Role-tooling opt-in, server + client halves (demo/server.mjs and
# lib/role-tooling.ts's isRoleToolingVisible). OFF by default so a stranger
# running `npm run demo` never sees the view-demo/return-to-admin controls;
# scripts/dev.sh sets both to 1 for the maintainer's own dev stack.
# Accepts "1" or "true"; anything else (including unset) is off. Set BOTH
# together -- they gate the server and client sides independently.
# DEMO_ROLE_TOOLING=1
# NEXT_PUBLIC_DEMO_ROLE_TOOLING=1
