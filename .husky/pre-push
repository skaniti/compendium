if [ "${ALLOW_PUSH:-}" != "1" ]; then
  echo 'pre-push: blocked. Pushing is a deliberate, user-run action.' >&2
  echo '  Re-run consciously with: ALLOW_PUSH=1 git push ...' >&2
  exit 1
fi

# Scan the outgoing commits (gitleaks + plan-path grep + identifier matrix).
# Runs after the ALLOW_PUSH gate so a blocked push wastes no scan; fails
# closed. Git's pre-push stdin (ref/sha lines) passes straight through.
bash scripts/pre-push-scan.sh --hook
