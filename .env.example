# Compendium Docker stack settings. Copy this file to `.env` (next to
# docker-compose.yml) and fill in every REQUIRED value before the first
# `docker compose up`. docker compose reads `.env` automatically, and git
# ignores it, so your values never get committed.
#
# Single-quote any value that contains $, # or spaces:
#   BOOTSTRAP_PASSWORD='pa$$ word#1'
# Unquoted, compose reads $ as a variable reference and " #" as a comment.

# ── Required ────────────────────────────────────────────────────────────

# Your login. Created on the first boot and re-applied from this file on
# every boot. To change your password, edit it here and run
# `docker compose up -d` again, which recreates the api container with the
# new value (`docker compose restart` keeps the old values).
# Changing BOOTSTRAP_EMAIL after the first boot creates a new, empty
# account; your existing data stays under the old email.
BOOTSTRAP_EMAIL=
# At least 8 characters.
BOOTSTRAP_PASSWORD=

# OpenAI API key. The capture pipeline, cluster naming and chat all call
# OpenAI, so ingesting pages spends credit.
OPENAI_API_KEY=

# Two random secrets. Generate each one with:  openssl rand -hex 32
JWT_SECRET_KEY=
SESSION_INGRESS_TRUSTED_VALUE=

# ── Optional ────────────────────────────────────────────────────────────

# Where the API listens. 0.0.0.0 (the default) lets the Android collector
# reach it on your network; 127.0.0.1 keeps it on this machine only.
# After changing it, run `docker compose up -d` (a restart keeps the old value).
# API_BIND_ADDRESS=0.0.0.0

# Display name for your account, used when the account is first created.
# BOOTSTRAP_NAME=user

# Change these only if you serve the web UI from another address.
# CORS_ORIGINS=http://localhost:3000
# FRONTEND_URL=http://localhost:3000

# Unused by this stack today.
# ANTHROPIC_API_KEY=
