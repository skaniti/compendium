# Backend base URL the Next /api/* proxy forwards to.
# Local dev: the FastAPI dev server. Prod (flip time): the public backend host.
BACKEND_URL=http://localhost:8001

# Absolute path to the backend repo, used ONLY by scripts/dev.sh to auto-start
# the FastAPI backend for local visual testing. Leave unset and dev.sh skips the
# backend (start it yourself, or run FRONTEND_ONLY=1).
# BACKEND_DIR=/path/to/compendium-explorer

# Prod-mode auth gate (proxy.ts). "1" redirects any page route without an
# access_token cookie to /login. UX only -- the backend's verify_api_key is
# the real enforcement point, this just avoids landing on a shell that will
# 401 everywhere. Leave unset/anything else to keep local dev's no-auth loop.
# AUTH_REQUIRED=1
