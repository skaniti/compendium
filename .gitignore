# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env files (real values never committed; example is allowed)
.env*
!.env.example

# vercel
/.vercel

# testing
/coverage

# typescript (incremental build cache)
*.tsbuildinfo

# SpecStory transcripts -- never track (may contain pasted secrets / file contents)
.specstory/

# auto-commit ledger -- operational, not product
.claude/auto-commit-log.jsonl

# hookify rules -- local operational guards, never product
# (canonical copies live with the migration plans; see routing-guard-handoff.md)
.claude/*.local.md

# local dev logs (timestamped; keep the README, drop the logs)
logs/*
!logs/README.md

# misc
*.log
.DS_Store
*.pem

# migration: ignore local-only/junk
.archive/
/*.png

# project plans -- symlink to dev
/docs/project-plans

# sdd scratch
.superpowers/
