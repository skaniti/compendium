# dependencies (workspaces layout: root node_modules is the hoisted
# install; a workspace can still get its own nested node_modules for
# non-hoistable deps -- unanchored so both match)
node_modules/

# next.js (unanchored: the app now lives at apps/web/, not root)
.next/
out/
# generated by `next dev`/`next build` on every run (declared "should not be
# edited" in its own header) -- machine/toolchain-specific, not source.
next-env.d.ts

# production
build/

# env files (real values never committed; example is allowed)
.env*
!.env.example

# vercel
.vercel/

# testing
coverage/

# typescript (incremental build cache)
*.tsbuildinfo

# SpecStory transcripts -- never track (may contain pasted secrets / file contents)
.specstory/

# auto-commit ledger -- operational, not product
.claude/auto-commit-log.jsonl

# hookify rules -- local operational guards, never product
# (canonical copies live with the migration plans; see routing-guard-handoff.md)
.claude/*.local.md

# machine-local claude settings (permission grants reference private paths)
.claude/settings.local.json

# local dev logs (timestamped; keep the README, drop the logs)
logs/*
!logs/README.md

# misc
*.log
.DS_Store
*.pem

# migration: ignore local-only/junk
.archive/
/*.png

# personal plan-annotator launchers (machine-local tooling, not product)
/annotate.sh
/annotate.bat
/annotate-hidden.vbs

# machine-local editor/runtime config
/.vscode/
# root-anchored: apps/api/.python-version is a real interpreter pin that
# SHOULD be tracked (packaging-relevant; uv.lock there is a stub with only
# a requires-python floor) -- an unanchored pattern here would have silently
# swallowed it too.
/.python-version

# python (apps/api)
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# apps/api test-run byproducts: the backup hook writes dump files, conftest
# rewrites the summary on every run, local runs may write logs. None belong
# in a public-bound history (an empty failed-dump .sql.gz slipped into
# 4e25b6b via git add -A before these rules existed; removed since).
apps/api/data/backups/
apps/api/data/logs/
apps/api/tests/test_summary.txt

# font design workbench (parked here; not part of the app)
/Constellation-inspired font design/

# project plans -- symlink to dev
/docs/project-plans

# sdd scratch
.superpowers/

# demo fixture capture: raw snapshots are machine-local; only Task 3's
# processed output under demo/fixtures/ (not raw/) is meant to be committed
apps/web/demo/fixtures/raw/
